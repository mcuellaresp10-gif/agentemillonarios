API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Análisis IA vía OpenRouter — https://openrouter.ai/keys (formato sk-or-v1-...)
OPENROUTER_API_KEY=
# Modelo opcional (ej. anthropic/claude-sonnet-4). Si vacío, usa varios por defecto.
OPENROUTER_MODEL=
# Valor de mercado (Transfermarkt vía Apify) — https://apify.com/lulzasaur/transfermarkt-scraper
APIFY_TOKEN=
APP_URL=http://localhost:5173
# En producción con Netlify: URL del sitio Netlify (https://xxx.netlify.app)
# Solo en Netlify (build): URL del API en Render sin barra final
NETLIFY_BACKEND_URL=
CACHE_DURATION_MS=14400000
PORT=3001
# Seguridad (sin login de usuarios)
API_FOOTBALL_DAILY_LIMIT=80
# Código de acceso opcional: REQUIRE_ACCESS_CODE=true + secreto largo aleatorio
REQUIRE_ACCESS_CODE=false
APP_ACCESS_SECRET=
VITE_TEAM_ID=1125
VITE_DEFAULT_SEASON=2026
VITE_TIMEZONE=America/Bogota
